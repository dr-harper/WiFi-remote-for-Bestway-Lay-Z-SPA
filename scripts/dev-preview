LOG_SAMPLE = """\
[211ms] === BOOT === freeHeap=42320, FW=preview-mode
[840ms] WiFi > BEGIN ssid='Badgers2' bssid=(auto) pwd_len=12  heap=41856  mode=11G  sleep=NONE
[6660ms] WiFi > GOT IP 192.168.1.235  gw=192.168.1.1  rssi=-58  ssid='Badgers2'  bssid=94:F7:BE:33:5D:14  ch=1
[6720ms] boot-guard armed for 60 s
[12120ms] BOOT-GUARD: ok (sta=1 ap=0) — disarming
"""

# ─── Build cache ─────────────────────────────────────────────────────

class _Cache:
    pages_dir = None

CACHE = _Cache()

def rebuild():
    """Run the template engine; output goes to a temp dir we serve from.
    Suppresses build.py's per-template print spam (one line per page per
    request would flood the preview console). Errors still print."""
    import io, contextlib
    if CACHE.pages_dir is None:
        CACHE.pages_dir = tempfile.mkdtemp(prefix="spa-preview-")
        print(f"  preview dir: {CACHE.pages_dir}")
    cwd = os.getcwd()
    os.chdir(WEBIF)
    try:
        with contextlib.redirect_stdout(io.StringIO()):
            build_web_interface(CACHE.pages_dir, WEBIF)
    finally:
        os.chdir(cwd)


# ─── HTTP server ─────────────────────────────────────────────────────

class PreviewHandler(SimpleHTTPRequestHandler):

    # Always rebuild from source on every request — slower but means
    # CSS/HTML edits are reflected immediately on browser refresh.
    def do_GET(self): rebuild(); self._dispatch()
    def do_POST(self): rebuild(); self._dispatch()

    def _dispatch(self):
        url = urlparse(self.path)
        path = url.path.rstrip("/")

        # 1. Synthetic API endpoints
        if path in [k.rstrip("/") for k in KNOWN_RESPONSES]:
            # Look up by both with-slash and without-slash variants.
            key = path if path in KNOWN_RESPONSES else path + "/"
            self._json(KNOWN_RESPONSES[key])
            return
        if path == "/scanwifi":
            self._json(SCAN_NETWORKS_RESPONSE)
            return
        if path == "/logs":
            self._send(200, "text/plain", LOG_SAMPLE.encode())
            return
        if path == "/login":
            # Set a fake session cookie + 302 to /
            self.send_response(302)
            self.send_header("Set-Cookie", "session=preview; Path=/")
            self.send_header("Location", "/")
            self.end_headers()
            return
        if path == "/logout":
            self.send_response(302); self.send_header("Location", "/login.html"); self.end_headers()
            return
        if path == "/restart":
            self._send(200, "text/plain", b"restart (preview no-op)")
            return
        # POSTs to /setxxx/, /addcommand/, etc — pretend they succeeded
        if path.startswith("/set") or path.startswith("/add") or \
           path.startswith("/edit") or path.startswith("/del") or \
           path.startswith("/cmdq_file") or path.startswith("/reset"):
            self._send(200, "text/plain", b"ok")
            return

        # 2. Static files (rendered HTML + static/ assets)
        # Map "/" → "/index.html"
        if path in ("", "/"):
            path = "/index.html"
        # Strip .gz suffix — the build writes non-gz files; the device
        # serves .gz to save flash, but for preview we have raw HTML.
        if path.endswith(".gz"):
            path = path[:-3]

        fs_path = os.path.join(CACHE.pages_dir, path.lstrip("/"))
        if os.path.isfile(fs_path):
            with open(fs_path, "rb") as f:
                body = f.read()
            ctype = mimetypes.guess_type(fs_path)[0] or "application/octet-stream"
            self._send(200, ctype, body)
            return

        self._send(404, "text/plain", f"Not found: {path}".encode())

    def _json(self, obj):
        self._send(200, "application/json", json.dumps(obj).encode())

    def _send(self, code, ctype, body):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    # Quiet down the default per-request log line; only print POST + errors
    def log_message(self, fmt, *args):
        msg = fmt % args
        if "GET /favicon" in msg or "GET /static" in msg:
            return
        print("  " + msg)


def main():
    p = argparse.ArgumentParser(description="Spa UI preview server")
    p.add_argument("--port", type=int, default=8000)
    p.add_argument("--host", default="127.0.0.1")
    args = p.parse_args()

    print(f"=== Spa UI preview ===")
    print(f"  webInterface:  {WEBIF}")
    rebuild()
    print(f"  serving on:    http://{args.host}:{args.port}/")
    print(f"  open:          http://{args.host}:{args.port}/login.html")
    print(f"                 (or /index.html, /wifi.html, /config.html, etc.)")
    print()
    httpd = HTTPServer((args.host, args.port), PreviewHandler)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nbye")

if __name__ == "__main__":
    main()
