#!/usr/bin/env python3
"""
Local preview server for the spa UI. Renders the template-engine pages
in real-time (rebuild on every request) and mocks the device's /api
endpoints with synthetic JSON so the JS doesn't error out.

Run:
  ./scripts/dev-preview              # serves on localhost:8000
  ./scripts/dev-preview --port 8123  # custom port

Then open http://localhost:8000/login.html (or any other page).
Edit any HTML / CSS / JS in webInterface/ and refresh — no device round-trip.

The synthetic responses come from KNOWN_RESPONSES below. Modify them
to test different states (connected vs disconnected, populated cmd
queue, etc.) without needing a real spa.
"""
import argparse
import json
import mimetypes
import os
import sys
import tempfile
from http.server import HTTPServer, SimpleHTTPRequestHandler
from urllib.parse import urlparse, parse_qs

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
WEBIF = os.path.join(ROOT, "Code", "webInterface")
# build.py lives inside webInterface/ and imports as `webInterface.build`.
# Adjust sys.path so we can import it without a package install.
sys.path.insert(0, os.path.join(ROOT, "Code"))
from webInterface.build import build_web_interface   # noqa: E402

# ─── Synthetic data ──────────────────────────────────────────────────
# Tune these to preview different device states without flashing.

KNOWN_RESPONSES = {
    "/getwifi/": {
